{
    "id": "texora-default",
    "name": "Texora",
    "short_name": "Texora",
    "start_url": "http://localhost:8000/",
    "scope": "http://localhost:8000/",
    "display": "standalone",
    "display_override": [
        "fullscreen",
        "standalone",
        "minimal-ui"
    ],
    "orientation": "portrait",
    "theme_color": "#111827",
    "background_color": "#ffffff",
    "icons": [
        {
            "src": "http://localhost:8000/pwa/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "http://localhost:8000/pwa/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "http://localhost:8000/pwa/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}